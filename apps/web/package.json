{
  "name": "posify-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "contracts": "openapi-typescript ../../packages/contracts/openapi.json -o src/contracts.d.ts",
    "contracts:check": "openapi-typescript ../../packages/contracts/openapi.json -o src/contracts.d.ts --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "^4.0.0"
  }
}
