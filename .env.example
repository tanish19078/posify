# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
POSIFY_API_TOKEN=replace-with-a-generated-token
POSIFY_DB=var/posify.db
# Optional; no model is downloaded or invoked unless explicitly configured.
POSIFY_OLLAMA_URL=http://127.0.0.1:11434
POSIFY_OLLAMA_MODEL=

# Image storage defaults to a captures directory beside POSIFY_DB.
POSIFY_CAPTURE_DIR=var/captures
# disabled | tesseract | paddle. Tesseract is an optional baseline, not PaddleOCR.
POSIFY_OCR_ENGINE=disabled
# Supply existing PP-OCRv5 model directories; the application does not download them.
POSIFY_PADDLE_DET_DIR=
POSIFY_PADDLE_REC_DIR=
# Existing local multilingual-e5-small snapshot; empty keeps lexical search.
POSIFY_EMBEDDING_DIR=
# Heuristic similarity cutoff, not a calibrated probability.
POSIFY_EMBEDDING_MIN_SCORE=0.80

# SQLite remains the default. PostgreSQL uses an operator-provided URL.
# POSIFY_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/posify
# PostgreSQL requires a separate migration step by default.
# POSIFY_AUTO_MIGRATE=false
# Optional inference manifest. No training/downloads are performed.
POSIFY_DETECTOR_MANIFEST=
# Docker Compose requires a URL-safe database password and the API token above.
POSIFY_DB_PASSWORD=

# development: shared bootstrap key plus individual bearer tokens.
# users: individual bearer tokens only; provision the first admin with scripts/create_admin.py.
POSIFY_AUTH_MODE=development
# Individual tokens expire; administrator-issued tokens default to 30 days.
# Transport must use HTTPS outside a loopback development environment.

# Maximum queued/running analysis jobs per factory (1–10000). Replays do not count twice.
POSIFY_QUEUE_LIMIT=100
